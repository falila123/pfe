APP_NAME="Bibliothèque universitaire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de données : service "db" du docker-compose (MySQL)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bibliotheque
DB_USERNAME=biblio
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Emails : driver log par défaut (les emails s'écrivent dans storage/logs)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Injectée à l'exécution depuis l'environnement du conteneur (docker-compose)
GOOGLE_BOOKS_API_KEY=
